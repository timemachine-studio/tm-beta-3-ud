# Required client configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional client flags
VITE_MAINTENANCE_MODE=false
VITE_ACCESS_TOKEN_REQUIRED=false
VITE_BETA_ACCESS_TOKEN=

# Server provider credentials (never expose these with a VITE_ prefix)
NVIDIA_API_KEY=
NIM_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
POLLINATIONS_API_KEY=
EAON_API_KEY=
AMD_API_KEY=
LLM7_API_KEY=
SECRETSTOAI_API_KEY=

# Web search, tried in this order: Tavily, then SearXNG, then Exa.
# TAVILY_API_KEY  - primary. Free tier is 1,000 credits/month, no card.
# SEARXNG_URL     - comma-separated instance origins, no trailing slash.
#                   Public instances almost always have format=json disabled,
#                   so this is only dependable against one you host.
# EXA_API_KEY     - last resort. $10/month in free credits, no card.
TAVILY_API_KEY=
SEARXNG_URL=
EXA_API_KEY=

# Server and operational settings
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=
ANON_TRIAL_SECRET=
# Signs the media URLs the server hands to the browser (/api/image, see
# api/_lib/mediaGate.ts). Optional: derived from the service-role key when
# unset. Set it to rotate media URLs independently of that key.
MEDIA_URL_SECRET=
ANON_DEFAULT_PERSONA_LIMIT=3
# Signed-in daily caps per persona (api/_lib/rateLimit.ts). Unset means the
# defaults: Air 400, PRO 200, Girlie unlimited. A number here puts a cap on.
# VITE_DEFAULT_PERSONA_LIMIT=400
# VITE_PRO_PERSONA_LIMIT=200
# VITE_GIRLIE_PERSONA_LIMIT=
PROVIDER_DAILY_CEILING=0
# Flight Controls → Skills → "Your skills" searches skills.sh (no key) and
# skillsmp.com. SkillsMP allows 50 anonymous searches a day for the whole
# deployment; a key from skillsmp.com raises that to 500. Optional.
# Needs supabase/migrations/user_skills.sql run once in the SQL editor.
SKILLSMP_API_KEY=

# How many times one chat turn may bounce between the server and the browser to
# reach the user's own Notes and history, or to run Python (shared/deviceTools.ts).
# Each round is a whole extra model call, so this is a cost dial: 0 turns the
# device tools off entirely, and anything above 10 is clamped. Unset means 6.
DEVICE_ROUND_BUDGET=6

# Encrypts the bearer tokens users give their own MCP servers (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Without it, servers that need a token cannot be added at all — the store
# fails closed rather than keeping a credential in plain text. Servers that
# need no token are unaffected.
MCP_CREDENTIAL_KEY=

# Max Mode's GitHub integration (api/_lib/github.ts). Register a GitHub App
# at github.com/settings/apps with:
#   Callback URL:            https://<your host>/github/callback
#   "Request user authorization (OAuth) during installation": on
#   "Expire user authorization tokens": on (recommended)
#   Repository permissions:  Contents — Read and write
#                            Pull requests — Read and write
#                            Administration — Read and write  (creating repositories)
#                            Metadata — Read-only
#   Where can it be installed: Any account
# The slug is the last part of the App's public URL (github.com/apps/<slug>).
# For local dev the callback is http://localhost:5173/github/callback — a
# GitHub App allows several callback URLs, so add both.
# When a user installs the App on "Only select repositories", a repository
# created from a workspace is not in that set until they add it; the panel
# says so and the push can be retried.
# Tokens are stored with MCP_CREDENTIAL_KEY above, so that must be set too.
# Unset means the GitHub panel says it is not configured; the rest of Max
# Mode works without it.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# How many tools must sit behind find_tools before it is worth its own schema.
# Raise it above the catalogue size to turn the meta-tool off. Unset means 2.
FIND_TOOLS_MIN_TAIL=2

# Dev only. "1" mounts a mock signed-in session so the signed-in UI can be
# worked on without a Supabase account (src/context/devMockAuth.ts). Only
# honoured by the Vite dev server; a production build ignores it. Server
# calls still need a real JWT and fail as they should.
# VITE_DEV_MOCK_USER=1

# Work: native cloud task worker (server and Trigger environments only).
# Review docs/work-harness-setup.md before enabling. Billing remains deferred.
TM_WORK_ENABLED=false
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Work: upstream monitoring/metadata export only, disabled by default.
# No sandbox commands, remote provisioning or full Agenta administration yet.
# Trusted origins must match exactly; credentials stay on the server. Database
# connection rows reference dedicated keys via TM_WORK_UPSTREAM_SECRET_<ref>.
TM_WORK_UPSTREAM_ENABLED=false
TM_WORK_AGENTA_EXPORT=false
TM_WORK_UPSTREAM_ORIGINS=
TM_WORK_ALLOW_LOOPBACK=false
# TM_WORK_UPSTREAM_SECRET_OWNER_ONE_AGENTA=
# TM_WORK_UPSTREAM_SECRET_OWNER_ONE_OPENHANDS=

# Server-to-server tool-capable TM model gateway. No runtime is launched by
# enabling this. Requires work_model_gateway.sql and an attested isolated binding.
TM_WORK_MODEL_GATEWAY_ENABLED=false
# Strong random signing secret (>=32 characters). Never prefix with VITE_.
TM_WORK_MODEL_GATEWAY_SECRET=
# Trusted server configuration only, never browser-supplied. A launch payload
# helper uses this; it does not provision or start an OpenHands sandbox.
TM_WORK_MODEL_GATEWAY_BASE_URL=
# Enable only after lifecycle SQL + canary and explicit recovery schedule setup.
# No schedule is created by this flag or by loading the task file.
TM_WORK_RUNTIME_STOP_RECOVERY_ENABLED=false
# Explicit opt-in only after runtime handoff SQL/canary, isolated Agent Server,
# model compatibility, approval/event/file UI and recovery acceptance checks.
TM_WORK_OPENHANDS_EXECUTION_ENABLED=false
# Optional read-only OpenHands event pagination. Server-only independent random
# secret (32–256 characters). Rotation invalidates existing encrypted cursors.
# Empty keeps the latest metadata page readable, with truncation shown honestly.
TM_WORK_EVENT_CURSOR_SECRET=
# Private intent ledger only; does not enable remote approval or execution.
TM_WORK_CONFIRMATION_LEDGER_ENABLED=false
TM_WORK_CONFIRMATION_SECRET=
# Optional read-only Hermes capabilities and skill catalog; no agent runs.
TM_WORK_HERMES_MONITORING_ENABLED=false
