# Required client configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional client flags
VITE_MAINTENANCE_MODE=false
VITE_ACCESS_TOKEN_REQUIRED=false
VITE_BETA_ACCESS_TOKEN=

# Server provider credentials (never expose these with a VITE_ prefix)
NVIDIA_API_KEY=
NIM_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
POLLINATIONS_API_KEY=
EAON_API_KEY=
SECRETSTOAI_API_KEY=

# Web search, tried in this order: Tavily, then SearXNG, then Exa.
# TAVILY_API_KEY  - primary. Free tier is 1,000 credits/month, no card.
# SEARXNG_URL     - comma-separated instance origins, no trailing slash.
#                   Public instances almost always have format=json disabled,
#                   so this is only dependable against one you host.
# EXA_API_KEY     - last resort. $10/month in free credits, no card.
TAVILY_API_KEY=
SEARXNG_URL=
EXA_API_KEY=

# Server and operational settings
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=
ANON_TRIAL_SECRET=
ANON_DEFAULT_PERSONA_LIMIT=3
PROVIDER_DAILY_CEILING=0
